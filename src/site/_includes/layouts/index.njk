    {%include "components/basesScript.njk"%}
<script>
(function() {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  function init() {
    // Create overlay once
    var overlay = document.createElement('div');
    overlay.id = 'image-preview-overlay';
    overlay.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:10000;pointer-events:none;display:none;background:rgba(255,255,255,0.01);';
    document.body.insertBefore(overlay, document.body.firstChild);

    var links = document.querySelectorAll('a.internal-link');

    // For each link, pre-fetch to detect image notes
    links.forEach(function(link) {
      var href = link.getAttribute('href');
      if (!href) return;

      // Start background fetch immediately
      fetch(href)
        .then(function(res) { return res.text(); })
        .then(function(html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          if (doc.getElementById('imgnote-marker')) {
            link.classList.add('image-note-link');
            var img = doc.querySelector('img');
            if (img) {
              // Store the image URL directly on the link element
              link._imgSrc = img.src;
              // Preload image
              new Image().src = img.src;
            }
          }
        });

      // Click handler
      link.addEventListener('click', function(e) {
        // If we already know it's an image note, toggle preview
        if (link.classList.contains('image-note-link')) {
          e.preventDefault();
          if (overlay.style.display === 'block') {
            overlay.style.display = 'none';
          } else {
            overlay.innerHTML = '<img src="' + link._imgSrc + '" style="width:100%;height:100%;object-fit:contain;opacity:0.3;">';
            overlay.style.display = 'block';
          }
          return;
        }

        // Still pending – prevent navigation and wait for fetch to resolve
        e.preventDefault();
        var href = link.getAttribute('href');
        fetch(href)
          .then(function(res) { return res.text(); })
          .then(function(html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            if (doc.getElementById('imgnote-marker')) {
              link.classList.add('image-note-link');
              var img = doc.querySelector('img');
              if (img) {
                link._imgSrc = img.src;
                new Image().src = img.src;
                overlay.innerHTML = '<img src="' + img.src + '" style="width:100%;height:100%;object-fit:contain;opacity:0.3;">';
                overlay.style.display = 'block';
              }
            } else {
              // Not an image note – navigate to the original destination
              window.location.href = href;
            }
          });
      });

      // Desktop hover
      link.addEventListener('mouseenter', function() {
        if (link._imgSrc) {
          overlay.innerHTML = '<img src="' + link._imgSrc + '" style="width:100%;height:100%;object-fit:contain;opacity:0.3;">';
          overlay.style.display = 'block';
        }
      });
      link.addEventListener('mouseleave', function() {
        if (link._imgSrc) {
          overlay.style.display = 'none';
        }
      });
    });
  }
})();
</script>
  </body>
</html>
